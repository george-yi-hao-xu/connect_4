{
  "name": "game_project",
  "version": "0.1.0",
  "description": "Connect4 terminal game in TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "local:dev": "tsc && node dist/index.js human-ai",
    "dev:web": "vite",
    "build:web": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "typescript",
    "connect4",
    "minimax"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/readline-sync": "^1.4.8",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "readline-sync": "^1.4.10"
  }
}
